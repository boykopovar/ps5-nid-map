cmake_minimum_required(VERSION 3.20)

if(NOT DEFINED DATA_DIRECTORY OR NOT DEFINED OUTPUT_DIRECTORY)
    message(FATAL_ERROR "DATA_DIRECTORY and OUTPUT_DIRECTORY are required")
endif()

function(write_if_changed path content)
    if(EXISTS "${path}")
        file(READ "${path}" previous)
        if(previous STREQUAL content)
            return()
        endif()
    endif()
    file(WRITE "${path}" "${content}")
endfunction()

function(generate_module path moduleIndex)
    get_filename_component(moduleName "${path}" NAME_WLE)
    if(NOT moduleName MATCHES "^[A-Za-z0-9_.+-]+$")
        message(FATAL_ERROR "Invalid module name: ${moduleName}")
    endif()
    file(STRINGS "${path}" lines)
    set(alphabet "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+-")
    set(libraryCount 0)
    set(inLibrary FALSE)
    set(haveFiles FALSE)
    set(files "")
    set(uniqueNids "")
    foreach(line IN LISTS lines)
        string(STRIP "${line}" line)
        if(line STREQUAL "")
            continue()
        elseif(line MATCHES "^PS5_NID_MAP_FILES\\((.*)\\)$")
            if(haveFiles OR inLibrary OR libraryCount GREATER 0)
                message(FATAL_ERROR "Expected one leading FILES record: ${path}")
            endif()
            set(arguments "${CMAKE_MATCH_1}")
            string(REGEX MATCHALL "\"[A-Za-z0-9_.+-]+\"" quotedFiles "${arguments}")
            if(NOT quotedFiles)
                message(FATAL_ERROR "Empty filename list: ${path}")
            endif()
            string(JOIN "," expected ${quotedFiles})
            string(REGEX REPLACE "[ \t]" "" actual "${arguments}")
            if(NOT actual STREQUAL expected)
                message(FATAL_ERROR "Invalid filename list: ${path}")
            endif()
            foreach(quoted IN LISTS quotedFiles)
                string(REGEX REPLACE "^\"|\"$" "" filename "${quoted}")
                if(NOT filename MATCHES "^[A-Za-z0-9_+-][A-Za-z0-9_.+-]*\\.(sprx|prx)$" OR filename IN_LIST files)
                    message(FATAL_ERROR "Invalid or duplicate filename: ${filename}")
                endif()
                list(APPEND files "${filename}")
            endforeach()
            set(haveFiles TRUE)
        elseif(line MATCHES "^PS5_NID_MAP_LIBRARY\\(\"([A-Za-z0-9_.+-]+)\",[ \t]*\\{$")
            if(NOT haveFiles OR inLibrary)
                message(FATAL_ERROR "Unexpected LIBRARY record: ${path}")
            endif()
            set(name "${CMAKE_MATCH_1}")
            if(DEFINED libraryIndex_${name})
                message(FATAL_ERROR "Duplicate library: ${name}")
            endif()
            math(EXPR libraryCount "${libraryCount} + 1")
            set(libraryIndex_${name} "${libraryCount}")
            set(libraryName_${libraryCount} "${name}")
            set(libraryNids_${libraryCount} "")
            set(item 0)
            set(inLibrary TRUE)
        elseif(line STREQUAL "})")
            if(NOT inLibrary OR item EQUAL 0)
                message(FATAL_ERROR "Empty or unexpected LIBRARY end: ${path}")
            endif()
            set(inLibrary FALSE)
        elseif(line MATCHES "^\"([A-Za-z0-9+-]+)\",?$")
            if(NOT inLibrary)
                message(FATAL_ERROR "NID outside library: ${path}")
            endif()
            set(nid "${CMAKE_MATCH_1}")
            string(LENGTH "${nid}" length)
            if(NOT length EQUAL 11)
                message(FATAL_ERROR "Invalid NID length: ${nid}")
            endif()
            string(SUBSTRING "${nid}" 10 1 last)
            string(FIND "${alphabet}" "${last}" digit)
            math(EXPR remainder "${digit} & 3")
            if(NOT remainder EQUAL 0)
                message(FATAL_ERROR "Noncanonical NID: ${nid}")
            endif()
            if(DEFINED seen_${libraryCount}_${nid})
                message(FATAL_ERROR "Duplicate NID in library: ${nid}")
            endif()
            set(seen_${libraryCount}_${nid} TRUE)
            if(NOT DEFINED firstLibrary_${nid})
                list(APPEND uniqueNids "${nid}")
                set(firstLibrary_${nid} "${libraryCount}")
                set(firstItem_${nid} "${item}")
                set(names_${nid} "")
            endif()
            list(APPEND names_${nid} "${libraryName_${libraryCount}}")
            list(APPEND libraryNids_${libraryCount} "${nid}")
            math(EXPR item "${item} + 1")
        else()
            message(FATAL_ERROR "Unexpected mapping syntax in ${path}: ${line}")
        endif()
    endforeach()
    if(NOT haveFiles OR inLibrary)
        message(FATAL_ERROR "Incomplete mapping file: ${path}")
    endif()
    list(SORT uniqueNids)
    list(LENGTH uniqueNids nidCount)
    set(bucketCount 1)
    while(bucketCount LESS nidCount)
        math(EXPR bucketCount "${bucketCount} * 2")
    endwhile()
    math(EXPR mask "${bucketCount} - 1")
    foreach(nid IN LISTS uniqueNids)
        set(bucket 0)
        foreach(character RANGE 0 9)
            string(SUBSTRING "${nid}" ${character} 1 symbol)
            string(FIND "${alphabet}" "${symbol}" digit)
            math(EXPR bucket "((${bucket} << 6) | ${digit}) & ${mask}")
        endforeach()
        string(SUBSTRING "${nid}" 10 1 symbol)
        string(FIND "${alphabet}" "${symbol}" digit)
        math(EXPR bucket "((${bucket} << 4) | (${digit} >> 2)) & ${mask}")
        list(APPEND bucket_${bucket} "${nid}")
    endforeach()
    set(source "#include <Ps5NidMap/Data/MappingMacros.hpp>\n\nnamespace Ps5NidMap::Detail {\nnamespace {\n\n")
    if(libraryCount GREATER 0)
        foreach(library RANGE 1 ${libraryCount})
            set(chunk 0)
            set(position 0)
            foreach(nid IN LISTS libraryNids_${library})
                if(position EQUAL 0)
                    string(APPEND source "constexpr auto Source${library}_${chunk} = std::tuple{\nPS5_NID_MAP_LIBRARY(\"${libraryName_${library}}\", {\n")
                endif()
                string(APPEND source "    \"${nid}\",\n")
                math(EXPR position "${position} + 1")
                if(position EQUAL 128)
                    string(APPEND source "})\n};\nconstexpr const auto& Library${library}_${chunk} = std::get<0>(Source${library}_${chunk});\n")
                    math(EXPR chunk "${chunk} + 1")
                    set(position 0)
                endif()
            endforeach()
            if(position GREATER 0)
                string(APPEND source "})\n};\nconstexpr const auto& Library${library}_${chunk} = std::get<0>(Source${library}_${chunk});\n")
            endif()
        endforeach()
    endif()
    set(entries "")
    set(bucketRecords "")
    set(secondary "")
    set(slots "")
    set(groupCode "")
    set(entryCount 0)
    set(groupCount 0)
    set(slotCount 0)
    math(EXPR lastBucket "${bucketCount} - 1")
    foreach(bucket RANGE ${lastBucket})
        set(first "${entryCount}")
        foreach(nid IN LISTS bucket_${bucket})
            list(SORT names_${nid})
            string(JOIN "," group ${names_${nid}})
            if(NOT DEFINED groupIndex_${group})
                set(groupIndex_${group} "${groupCount}")
                list(LENGTH names_${nid} nameCount)
                string(APPEND groupCode "        values[${groupCount}].reserve(${nameCount});\n")
                foreach(name IN LISTS names_${nid})
                    string(APPEND groupCode "        values[${groupCount}].emplace_back(Library${libraryIndex_${name}}_0.Name);\n")
                endforeach()
                math(EXPR groupCount "${groupCount} + 1")
            endif()
            list(LENGTH names_${nid} nameCount)
            math(EXPR chunk "${firstItem_${nid}} / 128")
            math(EXPR position "${firstItem_${nid}} % 128")
            string(APPEND entries "    {Library${firstLibrary_${nid}}_${chunk}.Nids[${position}].Value, {${groupIndex_${group}}, ${nameCount}}},\n")
            math(EXPR entryCount "${entryCount} + 1")
        endforeach()
        list(LENGTH bucket_${bucket} size)
        if(size GREATER 64)
            message(FATAL_ERROR "Primary bucket exceeds bounded constexpr construction: ${moduleName}")
        elseif(size EQUAL 0)
            string(APPEND bucketRecords "    {0, 0, 0},\n")
        elseif(size EQUAL 1)
            string(APPEND bucketRecords "    {${first}, 1, 0},\n")
        else()
            set(keys "")
            math(EXPR lastEntry "${entryCount} - 1")
            foreach(entry RANGE ${first} ${lastEntry})
                list(APPEND keys "Entries[${entry}].Key")
            endforeach()
            string(JOIN ", " keys ${keys})
            string(APPEND secondary "constexpr auto Secondary${bucket} = BuildSecondary(std::array<std::uint64_t, ${size}>{{${keys}}}, ${first});\n")
            math(EXPR square "${size} * ${size}")
            set(capacity 1)
            while(capacity LESS square)
                math(EXPR capacity "${capacity} * 2")
            endwhile()
            string(APPEND bucketRecords "    {${slotCount}, ${capacity}, Secondary${bucket}.Seed},\n")
            math(EXPR lastSlot "${capacity} - 1")
            foreach(slot RANGE ${lastSlot})
                string(APPEND slots "    Secondary${bucket}.Slots[${slot}],\n")
            endforeach()
            math(EXPR slotCount "${slotCount} + ${capacity}")
        endif()
    endforeach()
    string(APPEND source "\nconstexpr std::array<Entry<LibraryGroup, true>, ${entryCount}> Entries{{\n${entries}}};\n\n${secondary}\nconstexpr std::array<Bucket, ${bucketCount}> Buckets{{\n${bucketRecords}}};\n\nconstexpr std::array<std::uint32_t, ${slotCount}> Slots{{\n${slots}}};\n\nconst std::string& GetName() {\n    static const std::string name = \"${moduleName}\";\n    return name;\n}\n\nconst std::vector<std::string>& GetLibraries(std::size_t index) {\n    static const auto groups = [] {\n        std::array<std::vector<std::string>, ${groupCount}> values;\n${groupCode}        return values;\n    }();\n    return groups.at(index);\n}\n\n}\n\nextern constinit const ModuleData Module${moduleIndex}{\"${moduleName}\", {Entries, Buckets, Slots, 0}, GetName, GetLibraries};\n\n}\n\n#undef PS5_NID_MAP_FILES\n#undef PS5_NID_MAP_LIBRARY\n")
    write_if_changed("${OUTPUT_DIRECTORY}/Module${moduleIndex}.cpp" "${source}")
    set(moduleFiles "${files}" PARENT_SCOPE)
    set(moduleName "${moduleName}" PARENT_SCOPE)
endfunction()

file(GLOB modules "${DATA_DIRECTORY}/*.inc")
list(SORT modules)
list(LENGTH modules moduleCount)
if(moduleCount EQUAL 0)
    message(FATAL_ERROR "No module mapping files")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
set(index 0)
set(fileCount 0)
set(declarations "")
set(moduleEntries "")
set(fileEntries "")
foreach(module IN LISTS modules)
    generate_module("${module}" "${index}")
    string(APPEND declarations "extern const ModuleData Module${index};\n")
    string(APPEND moduleEntries "    {\"${moduleName}\", {&Module${index}}},\n")
    foreach(filename IN LISTS moduleFiles)
        if(DEFINED fileOwner_${filename})
            message(FATAL_ERROR "Filename assigned to multiple modules: ${filename}")
        endif()
        set(fileOwner_${filename} "${moduleName}")
        string(APPEND fileEntries "    {\"${filename}\", {&Module${index}}},\n")
        math(EXPR fileCount "${fileCount} + 1")
    endforeach()
    math(EXPR index "${index} + 1")
endforeach()
set(registry "${declarations}\nconstexpr std::array<Entry<ModuleReference>, ${moduleCount}> ModuleEntries{{\n${moduleEntries}}};\nconstexpr auto ModuleDictionary = BuildDictionary(ModuleEntries);\n\nconstexpr std::array<Entry<ModuleReference>, ${fileCount}> FileEntries{{\n${fileEntries}}};\nconstexpr auto FileDictionary = BuildDictionary(FileEntries);\n")
write_if_changed("${OUTPUT_DIRECTORY}/ModuleRegistry.inc" "${registry}")
file(TOUCH "${OUTPUT_DIRECTORY}/mapping.stamp")
